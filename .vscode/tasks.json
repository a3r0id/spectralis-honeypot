{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure (linux-docker-debug)",
            "type": "shell",
            "command": "cmake --preset linux-docker-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build (linux-docker-debug)",
            "type": "shell",
            "command": "cmake --build --preset linux-docker-debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake Configure (linux-docker-debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
