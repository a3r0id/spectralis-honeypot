{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Honeypot (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "HONEYPOT_PORT", "value": "102" },
                { "name": "HONEYPOT_BIND_ADDR", "value": "0.0.0.0" },
                { "name": "HONEYPOT_DEVICE", "value": "S7-200" }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "CMake Build (linux-docker-debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
